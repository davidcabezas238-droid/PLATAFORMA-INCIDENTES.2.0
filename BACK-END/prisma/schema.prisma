generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Incidente {
  id            Int     @id @default(autoincrement())
  titulo        String
  descripcion   String?
  prioridad     String
  estado        String  @default("abierto")
  archivoRuta   String?
  archivoNombre String?
  archivoMime   String?
}

model Usuario {
  id        Int      @id @default(autoincrement())
  correo    String   @unique
  clave     String
  rol       String   @default("tecnico")
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
}
